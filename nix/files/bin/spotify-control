#!/usr/bin/env bash
set -euo pipefail
# Control Spotify via playerctl. Invoked by makima [commands] (running as the
# session user) or any non-interactive launcher, so bootstrap the session bus
# instead of assuming it. Shows the Omarchy OSD as best-effort feedback.

export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}"

osd() {
  command -v omarchy-osd >/dev/null 2>&1 && omarchy-osd --icon "$1" -m "$2" || true
}

# Icon names come from the Omarchy OSD's fixed vocabulary (see iconFor in
# /usr/share/omarchy/shell/plugins/osd/OsdModel.js); unknown names render as
# literal text, which also lets us pass raw Nerd Font glyphs where no name
# exists (stop, alert).
cmd="${1:-}"
case "$cmd" in
  previous)   label="Previous"    icon="media-previous" ;;
  next)       label="Next"        icon="media-next" ;;
  play-pause) label="Play/Pause"  icon="media-play" ;;
  stop)       label="Stop"        icon="󰓛" ;;
  *) echo "Usage: ${0##*/} <previous|next|play-pause|stop>" >&2; exit 2 ;;
esac

# Report the state a toggle will produce. Spotify's MPRIS status updates
# asynchronously, so querying after the toggle races and reports the old
# state; read it before and invert instead.
if [[ $cmd == play-pause ]]; then
  case "$(playerctl --player=spotify status 2>/dev/null || true)" in
    Playing)        label="Paused"  icon="media-pause" ;;
    Paused|Stopped) label="Playing" icon="media-play" ;;
  esac
fi

if ! playerctl --player=spotify "$cmd"; then
  osd "󰀦" "Spotify not running"
  exit 1
fi

osd "$icon" "$label"
