#!/usr/bin/env bash
set -euo pipefail

# Git's gpg.ssh.program: payload on stdin, armored signature on stdout.
case "$OSTYPE" in
darwin*)
  bin="/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
  ;;
linux-gnu*)
  # op-ssh-sign resolves the 1Password agent socket itself when
  # SSH_AUTH_SOCK is unset (verified); guessing sockets here only risks
  # exporting the wrong one. An exported SSH_AUTH_SOCK is still honored
  # as an intentional override.
  bin="/opt/1Password/op-ssh-sign"
  ;;
*)
  echo "${0##*/}: unsupported OS: $OSTYPE" >&2
  exit 1
  ;;
esac

if [[ ! -x $bin ]]; then
  echo "${0##*/}: $bin not found — is 1Password installed?" >&2
  exit 1
fi

exec "$bin" "$@"
